<Window x:Class="WpfApiWrapperExample.SetupHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="Setup history" Height="550" Width="1050"
        WindowStartupLocation="CenterOwner">

    <!--
        The DevExpress GridControl provides everything the history needs without extra code:
        - Excel-style filter drop-down on every column header (values with counts, search, clear)
        - search panel matching any column
        - filter bar at the bottom showing the active filter, with a button to clear it
        - total summary with the number of rows shown
        - sorting, grouping (drag a column header to the group panel) and column resizing
    -->
    <dxg:GridControl x:Name="HistoryGrid" AutoGenerateColumns="None" Margin="4">
        <dxg:GridControl.Columns>
            <dxg:GridColumn FieldName="DisplayTimestamp" Header="Time" Width="150">
                <dxg:GridColumn.EditSettings>
                    <dxe:DateEditSettings DisplayFormat="yyyy-MM-dd HH:mm:ss"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="Username" Header="User" Width="120"/>
            <dxg:GridColumn FieldName="UpdateType" Header="Update type" Width="100"/>
            <dxg:GridColumn FieldName="PropertyName" Header="Property" Width="200"/>
            <dxg:GridColumn FieldName="OldValue" Header="Old value" Width="*"/>
            <dxg:GridColumn FieldName="NewValue" Header="New value" Width="*"/>
        </dxg:GridControl.Columns>

        <dxg:GridControl.TotalSummary>
            <dxg:GridSummaryItem SummaryType="Count" DisplayFormat="{}{0} changes" Alignment="Right"/>
        </dxg:GridControl.TotalSummary>

        <dxg:GridControl.View>
            <dxg:TableView AllowEditing="False"
                           NavigationStyle="Row"
                           ColumnFilterPopupMode="Excel"
                           ShowSearchPanelMode="Always"
                           SearchPanelNullText="Search all columns"
                           ShowTotalSummary="True"
                           ShowGroupPanel="True"/>
        </dxg:GridControl.View>
    </dxg:GridControl>
</Window>
